# Required: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=

# Docker Compose is a local-development profile. AWS production must use
# APP_ENV=production and AUTH_MODE=alb_oidc as documented in docs/aws-production.md.
APP_ENV=development
AUTH_MODE=local
WEB_HOST=0.0.0.0

# Local HTTP uses false. Production startup rejects false.
COOKIE_SECURE=false

# Maximum web upload size in bytes (default: 25 MiB).
MAX_UPLOAD_BYTES=26214400

# Maximum extracted JSON report size in bytes (default: 100 MiB).
MAX_REPORT_BYTES=104857600

# Structural and generated-output safety limits.
MAX_JSON_DEPTH=64
MAX_JSON_NODES=250000
MAX_REPORT_PACKAGES=100000
MAX_REPORT_ROWS=50000
MAX_EXPORT_BYTES=104857600
REPORTS_PER_MINUTE=6
SESSION_LIFETIME_MINUTES=30
